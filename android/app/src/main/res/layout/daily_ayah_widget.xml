<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/daily_ayah_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/prayer_widget_background"
    android:padding="10dp"
    android:layoutDirection="rtl">

    <LinearLayout
        android:id="@+id/daily_ayah_widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/daily_ayah_widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:text="آية اليوم"
            android:textColor="@color/prayer_widget_accent"
            android:textSize="11sp"
            android:fontFamily="@font/cairo_regular"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/daily_ayah_reference"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:gravity="end"
            android:text="@string/daily_ayah_widget_fallback_reference"
            android:textColor="@color/prayer_widget_text_secondary"
            android:textSize="11sp"
            android:fontFamily="@font/cairo_regular"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/daily_ayah_widget_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/daily_ayah_page"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/prayer_time_item_default"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="@string/daily_ayah_widget_fallback_page"
            android:textColor="@color/prayer_widget_text_secondary"
            android:textSize="11sp"
            android:fontFamily="@font/cairo_medium"
            android:maxLines="1" />

        <TextView
            android:id="@+id/daily_ayah_read_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/prayer_time_item_active"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="اقرأ في المصحف"
            android:textColor="@color/prayer_widget_accent"
            android:textSize="11sp"
            android:fontFamily="@font/cairo_bold"
            android:maxLines="1" />
    </RelativeLayout>

    <!-- The ayah is in the KFGQPC encoding, so it is set in the KFGQPC HAFS
         Uthmanic font it was written for (copied unmodified from the
         mushaf_text package, as its licence requires). Long ayahs shrink to
         fit before they are cut short. -->
    <TextView
        android:id="@+id/daily_ayah_text"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/daily_ayah_widget_header"
        android:layout_above="@id/daily_ayah_widget_footer"
        android:layout_marginTop="4dp"
        android:background="@drawable/prayer_time_item_default"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:text="@string/daily_ayah_widget_fallback_text"
        android:textColor="@color/prayer_widget_text_primary"
        android:textSize="18sp"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="11sp"
        android:autoSizeMaxTextSize="18sp"
        android:autoSizeStepGranularity="1sp"
        android:fontFamily="@font/uthmanic_hafs"
        android:gravity="center"
        android:textDirection="rtl"
        android:maxLines="8"
        android:ellipsize="end"
        android:lineSpacingExtra="2dp" />

</RelativeLayout>
