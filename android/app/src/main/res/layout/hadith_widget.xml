<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hadith_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/prayer_widget_background"
    android:padding="10dp"
    android:layoutDirection="rtl">

    <LinearLayout
        android:id="@+id/hadith_widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/hadith_widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:text="حديث اليوم"
            android:textColor="@color/prayer_widget_accent"
            android:textSize="11sp"
            android:fontFamily="@font/cairo_regular"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/hadith_widget_attribution"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:gravity="end"
            android:textColor="@color/prayer_widget_text_secondary"
            android:textSize="11sp"
            android:fontFamily="@font/cairo_regular"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/hadith_widget_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/hadith_grade"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:maxWidth="120dp"
            android:background="@drawable/prayer_time_item_default"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textColor="@color/prayer_widget_text_secondary"
            android:textSize="11sp"
            android:fontFamily="@font/cairo_medium"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone" />

        <TextView
            android:id="@+id/hadith_read_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/prayer_time_item_active"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="اقرأ الحديث"
            android:textColor="@color/prayer_widget_accent"
            android:textSize="11sp"
            android:fontFamily="@font/cairo_bold"
            android:maxLines="1" />
    </RelativeLayout>

    <TextView
        android:id="@+id/hadith_text"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/hadith_widget_header"
        android:layout_above="@id/hadith_widget_footer"
        android:layout_marginTop="4dp"
        android:background="@drawable/prayer_time_item_default"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="جاري تحميل الحديث..."
        android:textColor="@color/prayer_widget_text_primary"
        android:textSize="15sp"
        android:fontFamily="@font/ya_modernpro_bold"
        android:gravity="start|center_vertical"
        android:textDirection="rtl"
        android:maxLines="4"
        android:ellipsize="end"
        android:lineSpacingExtra="2dp" />

</RelativeLayout>
