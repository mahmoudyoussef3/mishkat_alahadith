<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hadith_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/prayer_widget_background"
    android:padding="10dp"
    android:layoutDirection="rtl">

    <LinearLayout
        android:id="@+id/hadith_widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/hadith_widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:text="حديث اليوم"
            android:textColor="@color/prayer_widget_accent"
            android:textSize="11sp"
            android:fontFamily="@font/cairo_regular"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/hadith_widget_attribution"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:gravity="end"
            android:textColor="@color/prayer_widget_text_secondary"
            android:textSize="11sp"
            android:fontFamily="@font/cairo_regular"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- A row of tiles, like a row of the prayer times grid. The grade tile
         is gone until the provider has a grade, so the button then spans the
         whole row; its margin sits on the grade tile for that reason. -->
    <LinearLayout
        android:id="@+id/hadith_widget_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/hadith_grade"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/prayer_time_item_default"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textColor="@color/prayer_widget_text_primary"
            android:textSize="12sp"
            android:fontFamily="@font/cairo_bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone" />

        <TextView
            android:id="@+id/hadith_read_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/prayer_time_item_active"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="اقرأ الحديث"
            android:textColor="@color/prayer_widget_accent"
            android:textSize="12sp"
            android:fontFamily="@font/cairo_bold"
            android:maxLines="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/hadith_text"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/hadith_widget_header"
        android:layout_above="@id/hadith_widget_footer"
        android:layout_marginTop="4dp"
        android:background="@drawable/prayer_time_item_default"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="جاري تحميل الحديث..."
        android:textColor="@color/prayer_widget_text_primary"
        android:textSize="13sp"
        android:fontFamily="@font/cairo_medium"
        android:gravity="center"
        android:textDirection="rtl"
        android:maxLines="4"
        android:ellipsize="end" />

</RelativeLayout>
