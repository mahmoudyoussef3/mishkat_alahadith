<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded brand-purple gradient card used as the background of the custom
     prayer notification content views. Mirrors the app/home-widget palette,
     with a soft glow behind the badge corner and a hairline edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="@color/notification_prayer_card_start"
                android:centerColor="@color/notification_prayer_card_center"
                android:endColor="@color/notification_prayer_card_end" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="1.0"
                android:centerY="0.0"
                android:gradientRadius="160dp"
                android:startColor="@color/notification_prayer_card_glow"
                android:endColor="@color/notification_prayer_card_glow_fade" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="@color/notification_prayer_card_stroke" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</layer-list>
